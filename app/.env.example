# Kopiera den här filen till .env och fyll i värdena från Supabase-projektet
# (Connect → Framework). Filen .env checkas aldrig in.
# I produktion sätts samma variabler i Netlify under Project configuration → Environment variables.
VITE_SUPABASE_URL=https://ditt-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=din-publishable-eller-anon-nyckel
